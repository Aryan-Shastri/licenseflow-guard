# Obtain sandbox app credentials from https://developer.paypal.com/
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Create an API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Check current model availability in your account. Can be overridden.
GEMINI_MODEL=gemini-3.5-flash-lite
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
APP_SIGNING_KEY=
# Optional; defaults to ./data/licenseflow.sqlite3
# DATABASE_PATH=./data/licenseflow.sqlite3
